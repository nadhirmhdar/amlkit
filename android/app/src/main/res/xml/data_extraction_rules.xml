<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup is false, so neither cloud nor device-transfer backup ever
     runs; this file exists only because the manifest attribute requires a
     target, and it is written to exclude everything either way as a second
     line of defense: the session token and any cached case data must never
     leave the device via a backup path. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
