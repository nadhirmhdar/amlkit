<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS-only everywhere by default -- this app carries regulated
     financial-crime PII, and README.md's own security stance for the server
     side (refuse to run unencrypted beyond loopback) applies just as much to
     the client. The one cleartext exception is 10.0.2.2, the Android
     emulator's alias for the host machine's localhost, so a debug build can
     talk to `python scripts/serve.py` running unmodified on a workstation
     during development without the developer standing up TLS locally too. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
