# Environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Sanctions data is refreshed from source, never committed.
# It is also licence-encumbered (OpenSanctions CC-BY-NC): committing it to a
# repository would be redistribution.
# Anchored to the repo root (leading /) -- an unanchored "data/" previously
# also matched a data/ package inside the Android app that used to live in
# this repo (now split out to nadhirmhdar/amlkit-mobile), silently
# swallowing it out of every commit.
/data/
*.db
*.db-wal
*.db-shm

# Scraped research captures (large, regenerable)
research/raw/

# Customer documents - never commit personal data
documents/

# Local scratch
scratch_*.py
.env

# MCP Toolbox binary (downloaded, not committed)
toolbox/toolbox
toolbox/toolbox.exe

